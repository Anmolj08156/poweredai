{
  // Cloudflare Worker + static assets for StudNexus.
  // The Worker (worker/index.ts) serves the built SPA via the ASSETS binding
  // and exposes /api/* for the admin bulk-email tool. AWS SES credentials are
  // Worker SECRETS (set via `wrangler secret put`), never committed here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poweredai",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve index.html for unknown non-asset, non-/api paths (client-side routing).
    "not_found_handling": "single-page-application",
    // Always route API calls through the Worker (never to the SPA fallback).
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Non-secret config. The email address in SES_FROM must be a verified SES
    // sender (or under a verified domain). The display name ("Anushka") is what
    // recipients see. Replies go to SES_REPLY_TO.
    "SES_REGION": "us-east-1",
    "SES_FROM": "Anmol from DataSmith Research Labs <founder@datasmithlabs.com>",
    "SES_REPLY_TO": "anmol@datasmithlabs.com"
  }
}
